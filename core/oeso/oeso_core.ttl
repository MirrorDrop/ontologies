@prefix oeso: <https://mirrordrop.org/ontologies/core/oeso#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix org:  <http://www.w3.org/ns/org#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# ================================================================
#  Ontology Header
# ================================================================

<https://mirrordrop.org/ontologies/core/oeso>
    a               owl:Ontology ;
    rdfs:label      "Open Entity State Ontology (OESO)" ;
    rdfs:comment    """Domain-agnostic ontology for describing real-world entities through
temporally bounded, immutable, sourced descriptions (States). Concrete source types,
acquisition methods, assessment criteria, and resolution methods belong in extending
vocabularies.""" ;
    owl:versionIRI  <https://mirrordrop.org/ontologies/core/oeso/2026-08-02> ;
    owl:versionInfo "0.2.4" ;
    dct:creator     "Joseph A. Stoffa" ;
    dct:license     <https://creativecommons.org/licenses/by/4.0/> ;
    dct:rights      "Released as open source under CC BY 4.0" ;
    skos:changeNote "v0.1.0 — Initial public release." ;
    skos:changeNote """v0.2.0 — States are now produced by exactly one StateActivity via
oeso:generatedBy (subproperty of oeso:generatedByActivity and prov:wasGeneratedBy),
replacing the direct State→Source hasSource edge and its cardinality restriction. A
State's sources are derived by traversing generatedBy → the activity's oeso:used inputs.
Removed oeso:hasSource. Added a common activity/provenance model for States, Assessments,
and resolution assertions; introduced source-defined Attributes and their Source
relationship; clarified bitemporal State properties; and replaced global DCAT subclass
mappings with OESO-specific source classes. BREAKING: queries and writers keying on
hasSource must migrate to the generatedBy/used traversal.""" ;
    skos:changeNote """v0.2.1 — Simplified the core State activity model by removing
AcquisitionActivity and DerivationActivity. StateActivity is now the sole core class for
activities that generate States; extending vocabularies may classify State activities by
workflow, method, or input type. Added IngestActivity for activities that acquire or
capture external information and generate Artifacts, and added Artifact as a general
preserved Source type.""" ;

    skos:changeNote """v0.2.2 — Removed application-specific optional metadata from OESO core: activityAsOfTime, artifactHash, assessmentDate, and equivalenceConfidence. OESO retains the structural Assessment and resolution models, while scoring systems, assessment result vocabularies, execution cutoffs, hashes, and storage/reproducibility metadata belong in extending ontologies such as MDPO or domain-specific vocabularies.""" ;
    skos:changeNote """v0.2.3 — Simplified generation provenance by removing the specialized
properties generatedBy, assessedBy, assignmentGeneratedBy, equivalenceGeneratedBy, and
mappingGeneratedBy. All generated OESO provenance entities now use the single
oeso:generatedByActivity relationship, with class-level restrictions constraining the
appropriate Activity subtype. BREAKING: data and queries using the removed specialized
properties must migrate to oeso:generatedByActivity.""" .
skos:changeNote """v0.2.4 — Renamed oeso:IngestActivity → oeso:ArtifactActivity for
naming parity (every activity is now named for the object it produces:
ArtifactActivity/StateActivity/ResolutionActivity/AssessmentActivity) and to remove
machinery-flavored terminology from core — 'ingest' describes an implementation
concern, not the activity's semantic shape. Renamed oeso:EntityAssignment →
oeso:StateAssignment (and oeso:EntityAssignmentActivity → oeso:StateAssignmentActivity)
to make explicit that a State is what is assigned to an Entity. Removed
oeso:attributeMappingScore — scoring is policy, not core structure, and belongs in
extending ontologies. BREAKING: consumers referencing IngestActivity,
EntityAssignment, EntityAssignmentActivity, or attributeMappingScore must migrate.""" .

# ================================================================
#  Core Classes
# ================================================================

oeso:Entity
    a            owl:Class ;
    rdfs:label   "Entity" ;
    rdfs:comment "A real-world thing described by States. Subclass to introduce typed domain entities." .

oeso:State
    a               owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label      "State" ;
    rdfs:comment    """Immutable, temporally bounded description of an Entity, produced by
exactly one StateActivity. Bitemporal: hasStateDate begins the real-world interval the
State is understood to represent the Entity; hasStateValidTo ends that interval and is
open if absent; hasStateCreationDate records transaction time and is never modified.
The State's source(s) are derived by traversing generatedByActivity → the activity's used inputs.
Corrections create new States; prior States are retained permanently.""" ;
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty oeso:generatedByActivity ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass oeso:StateActivity ] ,
        [ a owl:Restriction ;
          owl:onProperty oeso:hasStateDate ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty oeso:hasStateValidTo ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty oeso:hasStateCreationDate ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] .

oeso:Source
    a               owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label      "Source" ;
    rdfs:comment    "Provenance entity from which a State or other generated assertion is derived. Abstract — subclass to introduce typed sources." .

oeso:Artifact
    a               owl:Class ;
    rdfs:subClassOf oeso:Source ;
    rdfs:label      "Artifact" ;
    rdfs:comment    "A preserved information-bearing Source generated by exactly one IngestActivity and available for later use as provenance evidence or processing input." ;
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty oeso:generatedByActivity ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass oeso:IngestActivity ] .

oeso:DatasetSource
    a               owl:Class ;
    rdfs:subClassOf oeso:Source, dcat:Dataset ;
    rdfs:label      "Dataset Source" ;
    rdfs:comment    "A DCAT Dataset used as an OESO Source." .

oeso:DistributionSource
    a               owl:Class ;
    rdfs:subClassOf oeso:Source, dcat:Distribution ;
    rdfs:label      "Distribution Source" ;
    rdfs:comment    "A DCAT Distribution used as an OESO Source." .

oeso:Organization
    a               owl:Class ;
    rdfs:subClassOf org:Organization ;
    rdfs:label      "Organization" ;
    rdfs:comment    "A formal group responsible for publishing Sources." .

oeso:Attribute
    a               owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label      "Source Attribute" ;
    rdfs:comment    """An identifier for a field, column, key, property, or other named
attribute defined by a Source. Attribute identifiers are conventionally minted as
<source-uri>/attribute/<attribute-name>. They identify source-native attributes and are
not necessarily RDF properties.""" ;
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty oeso:attributeOf ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] .

oeso:Assessment
    a               owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label      "Assessment" ;
    rdfs:comment    "Immutable record evaluating a Source, State, Attribute, or other provenance entity. Produced by exactly one AssessmentActivity. Subclass to define specific assessment types." ;
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty oeso:generatedByActivity ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass oeso:AssessmentActivity ] ,
        [ a owl:Restriction ;
          owl:onProperty oeso:assesses ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

oeso:StateAssignment
    a               owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label      "State Assignment" ;
    rdfs:comment    "Reified assertion that a State describes a particular Entity. Produced by exactly one StateAssignmentActivity." ;
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty oeso:generatedByActivity ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass oeso:StateAssignmentActivity ] ,
        [ a owl:Restriction ;
          owl:onProperty oeso:assignsState ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty oeso:assignsToEntity ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] .

oeso:EntityEquivalence
    a               owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label      "Entity Equivalence" ;
    rdfs:comment    "Reified assertion that two or more Entity UUIDs refer to the same real-world thing. Produced by exactly one EntityEquivalenceActivity. Minimum two entities required." ;
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty oeso:generatedByActivity ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass oeso:EntityEquivalenceActivity ] ,
        [ a owl:Restriction ;
          owl:onProperty oeso:hasEntity ;
          owl:minCardinality "2"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty oeso:canonicalEntity ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

oeso:AttributeMapping
    a               owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label      "Attribute Mapping" ;
    rdfs:comment    "Reified assertion that two or more source-defined Attributes represent the same real-world concept. Produced by exactly one AttributeMappingActivity. Minimum two attributes required." ;
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty oeso:generatedByActivity ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass oeso:AttributeMappingActivity ] ,
        [ a owl:Restriction ;
          owl:onProperty oeso:mapsAttribute ;
          owl:minCardinality "2"^^xsd:nonNegativeInteger ] .

# ================================================================
#  Activity Classes
# ================================================================

oeso:Activity
    a               owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label      "OESO Activity" ;
    rdfs:comment    "Abstract parent for activities that generate immutable OESO provenance entities." ;
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty prov:startedAtTime ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty prov:endedAtTime ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

oeso:IngestActivity
    a               owl:Class ;
    rdfs:subClassOf oeso:Activity ;
    rdfs:label      "Ingest Activity" ;
    rdfs:comment    "An activity that retrieves, receives, captures, or otherwise acquires external information and generates one or more Artifacts. Concrete ingestion methods and platform execution details belong in extending vocabularies." .

oeso:StateActivity
    a               owl:Class ;
    rdfs:subClassOf oeso:Activity ;
    rdfs:label      "State Activity" ;
    rdfs:comment    "An activity that generates one or more immutable States. OESO does not distinguish State activities by workflow, method, implementation role, or input type; extending vocabularies may introduce those classifications." .

oeso:AssessmentActivity
    a               owl:Class ;
    rdfs:subClassOf oeso:Activity ;
    rdfs:label      "Assessment Activity" ;
    rdfs:comment    "Produces an Assessment. Peer of StateActivity — it does not produce a State." .

oeso:ResolutionActivity
    a               owl:Class ;
    rdfs:subClassOf oeso:Activity ;
    rdfs:label      "Resolution Activity" ;
    rdfs:comment    "Abstract parent for activities that resolve relationships between entities, states, and attributes. Does not produce a State." .

oeso:StateAssignmentActivity
    a               owl:Class ;
    rdfs:subClassOf oeso:ResolutionActivity ;
    rdfs:label      "State Assignment Activity" ;
    rdfs:comment    "Produces an StateAssignment asserting that a State describes a particular Entity." .

oeso:EntityEquivalenceActivity
    a               owl:Class ;
    rdfs:subClassOf oeso:ResolutionActivity ;
    rdfs:label      "Entity Equivalence Activity" ;
    rdfs:comment    "Produces an EntityEquivalence asserting that two or more Entity UUIDs refer to the same real-world thing." .

oeso:AttributeMappingActivity
    a               owl:Class ;
    rdfs:subClassOf oeso:ResolutionActivity ;
    rdfs:label      "Attribute Mapping Activity" ;
    rdfs:comment    "Produces an AttributeMapping asserting that two or more source-defined Attributes represent the same real-world concept." .

# ================================================================
#  Object Properties
# ================================================================

oeso:generatedByActivity
    a                  owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasGeneratedBy ;
    rdfs:label         "generated by activity" ;
    rdfs:comment       "Generic relationship from an immutable OESO provenance entity to the OESO Activity that generated it." ;
    rdfs:domain        prov:Entity ;
    rdfs:range         oeso:Activity .

oeso:used
    a                  owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:label         "used" ;
    rdfs:comment       "An input consumed by an OESO Activity, including artifacts, Distributions, Sources, States, Attributes, prior assertions, rules, model artifacts, or other evidence. Multiple permitted." ;
    rdfs:domain        oeso:Activity ;
    rdfs:range         prov:Entity .

oeso:assesses
    a            owl:ObjectProperty ;
    rdfs:label   "assesses" ;
    rdfs:comment "Links an Assessment to the Source, State, Attribute, or other provenance entity it evaluates." ;
    rdfs:domain  oeso:Assessment ;
    rdfs:range   prov:Entity .

oeso:hasAssessment
    a             owl:ObjectProperty ;
    owl:inverseOf oeso:assesses ;
    rdfs:label    "has assessment" ;
    rdfs:comment  "Links a provenance entity to an Assessment that evaluates it." ;
    rdfs:domain   prov:Entity ;
    rdfs:range    oeso:Assessment .

oeso:attributeOf
    a            owl:ObjectProperty ;
    rdfs:label   "attribute of" ;
    rdfs:comment "Links a source-defined Attribute to the Source that defines it. This semantic relationship is explicit even when it is also encoded in the Attribute URI." ;
    rdfs:domain  oeso:Attribute ;
    rdfs:range   oeso:Source .

oeso:assignsState
    a            owl:ObjectProperty ;
    rdfs:label   "assigns state" ;
    rdfs:domain  oeso:EntityAssignment ;
    rdfs:range   oeso:State .

oeso:assignsToEntity
    a            owl:ObjectProperty ;
    rdfs:label   "assigns to entity" ;
    rdfs:domain  oeso:EntityAssignment ;
    rdfs:range   oeso:Entity .

oeso:hasEntity
    a            owl:ObjectProperty ;
    rdfs:label   "has entity" ;
    rdfs:comment "Links an EntityEquivalence to one of the Entity UUIDs in the equivalence cluster. Minimum two per EntityEquivalence." ;
    rdfs:domain  oeso:EntityEquivalence ;
    rdfs:range   oeso:Entity .

oeso:canonicalEntity
    a            owl:ObjectProperty ;
    rdfs:label   "canonical entity" ;
    rdfs:comment "Links an EntityEquivalence to the canonical Entity UUID designated to represent the equivalence cluster. At most one per EntityEquivalence." ;
    rdfs:domain  oeso:EntityEquivalence ;
    rdfs:range   oeso:Entity .

oeso:mapsAttribute
    a            owl:ObjectProperty ;
    rdfs:label   "maps attribute" ;
    rdfs:comment "Links an AttributeMapping to one of the source-defined Attributes participating in the mapping. Minimum two per AttributeMapping." ;
    rdfs:domain  oeso:AttributeMapping ;
    rdfs:range   oeso:Attribute .

oeso:attributeMappingScope
    a            owl:ObjectProperty ;
    rdfs:label   "attribute mapping scope" ;
    rdfs:comment "Optionally scopes an AttributeMapping to specific Sources or source versions where the mapping applies." ;
    rdfs:domain  oeso:AttributeMapping ;
    rdfs:range   oeso:Source .

# ================================================================
#  Datatype Properties
# ================================================================

oeso:hasStateDate
    a            owl:DatatypeProperty ;
    rdfs:label   "valid-from datetime" ;
    rdfs:comment """The beginning of the interval in real-world time during which the
State is understood to represent the Entity. This is valid time, not the time the State
was created, ingested, or stored.""" ;
    rdfs:domain  oeso:State ;
    rdfs:range   xsd:dateTime .

oeso:hasStateValidTo
    a            owl:DatatypeProperty ;
    rdfs:label   "valid-to datetime" ;
    rdfs:comment "The end of the interval in real-world time during which the State is understood to represent the Entity. Omit to indicate an open interval or a State still understood to be current." ;
    rdfs:domain  oeso:State ;
    rdfs:range   xsd:dateTime .

oeso:hasStateCreationDate
    a            owl:DatatypeProperty ;
    rdfs:label   "transaction datetime" ;
    rdfs:comment "The datetime the immutable State was first written to the Entity State Store. Set once and never modified." ;
    rdfs:domain  oeso:State ;
    rdfs:range   xsd:dateTime .

# ================================================================
#  Disjointness
# ================================================================

[ a           owl:AllDisjointClasses ;
  owl:members ( oeso:IngestActivity oeso:StateActivity
                oeso:ResolutionActivity oeso:AssessmentActivity ) ] .

[ a           owl:AllDisjointClasses ;
  owl:members ( oeso:StateAssignmentActivity oeso:EntityEquivalenceActivity
                oeso:AttributeMappingActivity ) ] .
